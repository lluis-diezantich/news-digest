# Copy to .env for local runs (the CLI loads .env if present).
# In GitHub Actions these come from repository secrets and variables instead.
# .env is gitignored. Never commit a filled-in copy.

# --- Mailbox ------------------------------------------------------------------
# The dedicated inbox the newsletters arrive in. Use an account that receives
# NOTHING else: everything in it is read, and a source is recognised by sender
# address, so personal mail in the same box is just noise to be counted as
# unmatched.
#
# The connection is opened read-only, so a run can neither delete a newsletter
# nor mark one seen. Re-running a week is always safe.
#
# On a provider with two-factor authentication this must be an app-specific
# password, not the account password. Gmail: an App Password with IMAP enabled.
# Fastmail and Proton: an app password from the security settings.
NEWS_EMAIL_HOST=imap.example.com
NEWS_EMAIL_PORT=993
NEWS_EMAIL_USERNAME=newsdigest@example.com
NEWS_EMAIL_PASSWORD=
# NEWS_EMAIL_FOLDER=INBOX
# NEWS_EMAIL_TIMEOUT=30
# imap is the only provider today. The interface is there so an OAuth or HTTP
# API client can be added as one module (section 3).
# MAILBOX_PROVIDER=imap

# --- Keys ---------------------------------------------------------------------
# One Gemini key serves both the LLM and the embeddings.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- LLM ----------------------------------------------------------------------
# gemini -> Google API. ollama -> a local model, no API and no quota, but it
# needs a machine with real memory: a GitHub runner (2 vCPU, no GPU) cannot do
# this inside the 45-minute job, an Apple-silicon laptop can. Install Ollama,
# then `ollama pull qwen3:8b`. none -> built-in heuristics, no model, no cost.
# With no key, both fall back to `none` automatically.
LLM_PROVIDER=gemini
# Local-only settings, ignored by hosted providers.
# LLM_BASE_URL=http://localhost:11434
# A batch of 16 articles with 900-char excerpts overflows a 4k window, and an
# overflowed prompt is truncated silently -- it shows up as missing ids.
# LLM_NUM_CTX=8192
# Seconds allowed for one request. Defaults to 300 for ollama and 90 otherwise,
# because a local model generates every token on your machine. Do not lower it
# for a local run: at 90s a batch of 16 on qwen3:8b times out, and both
# enrichment and cluster adjudication give up quietly while the digest still
# publishes -- the only signs are `enriched: 0` and a `batch failed` warning.
# LLM_TIMEOUT=300
# gemini-2.5-flash was retired for new API keys (404, verified 2026-09-14).
# gemini-3.6-flash and gemini-3.5-flash-lite both work.
# LLM_MODEL=gemini-3.6-flash
# LLM_BATCH_SIZE=8              # items per request, for classify and enrich
# LLM_ARTICLES_PER_RUN=400      # hard cap on articles sent for enrichment
# A per-minute 429 is transient and gets waited out; a per-day one is terminal.
# RETRIES is waits per request, WAIT the seconds one run may spend waiting in
# total (it must stay well inside the workflow's 45-minute timeout).
# LLM_RATE_LIMIT_RETRIES=3
# LLM_RATE_LIMIT_WAIT=600
# Thinking level: low | medium | high, or `off` to send no field and take the
# model's default. Thought tokens are billed as output, count against the
# per-minute token allowance, and come out of maxOutputTokens -- and this is
# schema-enforced extraction, so `low` is what it wants.
# LLM_THINKING_LEVEL=low
# Ask the LLM to adjudicate borderline clusters. Costs one request per batch of
# pairs; set CHECKS=0 to turn the phase off and let the embedding decide.
# LLM_RESOLVE_CLUSTERS=true
# LLM_MAX_CLUSTER_CHECKS=40

# --- Embeddings ---------------------------------------------------------------
# These do the cross-language clustering. Without them, coverage of one event in
# English and Spanish stays split into two separate stories -- measured on one
# headline in three languages, token overlap scores 0.00 and 0.06 against a 0.60
# merge threshold, so no threshold rescues it.
#
# gemini -> Google API. local -> fastembed/ONNX on this machine, no API, no
# quota. Local also stops embeddings competing with the LLM for one free-tier
# budget. Needs `pip install 'news-digest[local]'`.
EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_API_KEY=            # only if it differs from GEMINI_API_KEY
# 256 keeps the committed database small (~1 KB/article). 768 triples that.
# EMBEDDING_DIMENSIONS=256
# Cosine similarity at/above which two articles are the same event; between
# AMBIGUOUS and SIMILARITY the LLM is asked to decide.
# THESE ARE MODEL-SPECIFIC. Cosine values do not transfer between embedding
# models. For gemini-embedding-2: 0.82 / 0.72. For the local MiniLM with
# adjudication ON: 0.80 / 0.65. Do not narrow the band while
# LLM_MAX_CLUSTER_CHECKS=0: with checks off the band merges nothing, so the two
# knobs have to move together. Below 0.60 MiniLM collapses into one blob.
# EMBEDDING_SIMILARITY_THRESHOLD=0.82
# EMBEDDING_AMBIGUOUS_THRESHOLD=0.72
# EMBEDDING_RATE_LIMIT_RETRIES=3
# EMBEDDING_RATE_LIMIT_WAIT=600

# --- Misc ---------------------------------------------------------------------
# Sent as User-Agent when resolving a tracking link to the article behind it.
# That is the only HTTP this project makes.
# NEWS_DIGEST_USER_AGENT=news-digest/0.3 (+https://github.com/<you>/news-digest)
