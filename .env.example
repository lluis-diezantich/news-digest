# Copy to .env for local runs (the CLI loads .env if present).
# In GitHub Actions these come from repository secrets and variables instead.

# --- Keys ---------------------------------------------------------------------
# One Gemini key serves both the LLM and the embeddings.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- LLM ----------------------------------------------------------------------
# gemini -> Google Gemini. none -> offline heuristics, no calls, no cost.
# With no key, both fall back to `none` automatically.
LLM_PROVIDER=gemini
# gemini-2.5-flash was retired for new API keys (404, verified 2026-09-14).
# gemini-3.6-flash and gemini-3.5-flash-lite both work; lite is cheaper if you
# ever leave the free tier and may carry looser rate limits.
# LLM_MODEL=gemini-3.6-flash
# LLM_BATCH_SIZE=8              # articles per request
# LLM_ARTICLES_PER_RUN=400      # hard cap on articles sent to the LLM per week
# A per-minute 429 is transient and gets waited out; a per-day one is terminal.
# RETRIES is waits per request, WAIT the seconds one run may spend waiting in
# total (it must stay well inside the workflow's 45-minute timeout). Set
# RETRIES=0 to go back to failing fast on any 429.
# LLM_RATE_LIMIT_RETRIES=3
# LLM_RATE_LIMIT_WAIT=600
# Thinking level: low | medium | high, or `off` to send no field and take the
# model's default. Thought tokens are billed as output, count against the
# per-minute token allowance, and come out of maxOutputTokens -- and this is
# schema-enforced extraction, so `low` -- the cheapest level the 3.x Flash
# models accept -- is what it wants. `off` sends no field at all.
# LLM_THINKING_LEVEL=low

# --- Embeddings ---------------------------------------------------------------
# These do the cross-language clustering; without them, coverage of one event in
# different languages stays split into separate stories.
# gemini -> Google API. local -> fastembed/ONNX on this machine, no API, no
# quota. Measured on 551 real articles: local gave 442 clusters and 20
# cross-language groups in 8.5s, against gemini's 445 / 10 in ~5 minutes (mostly
# waiting out per-minute 429s). Local also stops embeddings competing with the
# LLM for one free-tier budget. Needs `pip install 'news-digest[local]'`.
EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_API_KEY=            # only if it differs from GEMINI_API_KEY
# 256 keeps the committed database small (~1 KB/article). 768 triples that.
# EMBEDDING_DIMENSIONS=256
# Cosine similarity at/above which two articles are the same event; between
# AMBIGUOUS and SIMILARITY the LLM is asked to decide.
# THESE ARE MODEL-SPECIFIC. Cosine values do not transfer between embedding
# models. For gemini-embedding-2: 0.82 / 0.72. For the local MiniLM model:
# 0.70 / 0.60 (measured; at 0.82 it under-merges to 9 cross-language groups, and
# below 0.60 it collapses into one 300-article blob). The local provider warns if
# it sees a gemini-shaped threshold.
# EMBEDDING_SIMILARITY_THRESHOLD=0.82
# EMBEDDING_AMBIGUOUS_THRESHOLD=0.72
# Unsupported on gemini-embedding-2; leave unset unless you pin an older model.
# EMBEDDING_TASK_TYPE=SEMANTIC_SIMILARITY
# As the LLM pair above.
# EMBEDDING_RATE_LIMIT_RETRIES=3
# EMBEDDING_RATE_LIMIT_WAIT=600

# --- Misc ---------------------------------------------------------------------
# Public URL of your Pages site, used for absolute links in the RSS output.
# SITE_URL=https://you.github.io/news-digest/
# Sent as User-Agent so site owners can identify and contact you.
# NEWS_DIGEST_USER_AGENT=news-digest/0.2 (+https://github.com/<you>/news-digest)
