# Copy to .env for local runs (the CLI loads .env if present).
# In GitHub Actions these come from repository secrets instead.

# --- LLM ---------------------------------------------------------------------
# Provider: gemini | none
#   gemini -> Google Gemini API (free tier). Get a key: https://aistudio.google.com/apikey
#   none   -> offline heuristic enrichment, no API calls. Good for local dev/tests.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional overrides:
# LLM_MODEL=gemini-2.5-flash
# LLM_ARTICLES_PER_RUN=60        # hard cap on articles sent to the LLM per run
# LLM_BATCH_SIZE=8               # articles per API call

# --- Fetching ----------------------------------------------------------------
# Sent as User-Agent so site owners can identify and contact you.
# NEWS_DIGEST_USER_AGENT=news-digest/0.1 (+https://github.com/<you>/news-digest)
